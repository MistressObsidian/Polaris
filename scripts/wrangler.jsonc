{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polaris",
  "main": "worker.js",
  "compatibility_date": "2026-09-16",
  "vars": {
    "NODE_ENV": "production",
    "APP_BASE_URL": "https://polaris.dark-surf-56ad.workers.dev",
    "CORS_ORIGINS": "https://polaris.dark-surf-56ad.workers.dev"
  },
  "assets": {
    "directory": "./frontend",
    "run_worker_first": ["/api/*"]
  }
}
