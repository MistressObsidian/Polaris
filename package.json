{
  "name": "polaris",
  "version": "1.0.0",
  "type": "module",
  "description": "Minimal backend for registration and login routes",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test tests/admin-operations.test.js tests/admin-session.test.js tests/login.test.js tests/layout.test.js tests/dashboard.test.js tests/investments.test.js",
    "start": "node src/server.js",
    "api": "node src/server.js",
    "serve": "http-server -p 5173 -c-1 frontend",
    "dev": "nodemon src/server.js",
    "dev:all": "concurrently -n api,web -c blue,magenta \"nodemon src/server.js\" \"http-server -p 5173 -c-1 frontend\"",
    "db:migrate": "node scripts/db/migrate-db.js up",
    "db:migrate:status": "node scripts/db/migrate-db.js status",
    "db:migrate:new": "node scripts/db/new-migration.js",
    "worker:admin": "node scripts/cloudflare/worker-admin.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "http-server": "^14.1.1",
    "nodemon": "^3.1.11",
    "wrangler": "^4.134.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MistressObsidian/Polaris.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MistressObsidian/Polaris/issues"
  },
  "homepage": "https://github.com/MistressObsidian/Polaris#readme"
}
